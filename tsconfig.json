{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "openclaw/plugin-sdk/*": [
        "/opt/homebrew/lib/node_modules/openclaw/dist/plugin-sdk/*"
      ]
    }
  },
  "include": ["src/**/*", "index.ts", "setup-entry.ts", "vitest.config.ts"]
}
