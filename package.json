{
  "name": "@othreecodes/openclaw-intercom",
  "version": "1.0.4",
  "description": "OpenClaw channel plugin for Intercom. The agent works as a support teammate: receives conversations by polling or webhook and replies to customers via the Intercom API.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "intercom",
    "support",
    "customer-support",
    "helpdesk",
    "chatbot"
  ],
  "homepage": "https://github.com/othreecodes/openclaw-intercom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/othreecodes/openclaw-intercom.git"
  },
  "bugs": {
    "url": "https://github.com/othreecodes/openclaw-intercom/issues"
  },
  "license": "MIT",
  "author": "Obi Uchenna David",
  "type": "module",
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "install": {
      "clawhubSpec": "clawhub:@othreecodes/openclaw-intercom",
      "npmSpec": "@othreecodes/openclaw-intercom",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.0"
    },
    "compat": {
      "pluginApi": ">=2026.8.0"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    },
    "channel": {
      "id": "intercom",
      "label": "Intercom",
      "blurb": "Answer Intercom conversations as a support teammate: polling or webhook inbound, auto-reply, and inline close, escalate, note and tag actions.",
      "systemImage": "questionmark.bubble",
      "docsPath": "https://github.com/othreecodes/openclaw-intercom#readme"
    }
  }
}
